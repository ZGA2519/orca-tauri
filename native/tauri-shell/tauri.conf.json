{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca Tauri",
  "version": "0.1.0",
  "identifier": "com.stablyai.orca.tauri",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orca",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../resources/build/icon.png",
      "../../resources/build/icon.icns",
      "../../resources/build/icon.ico"
    ],
    "resources": {
      "../../out/orcad/": "orcad/",
      "../../out/runtimes/": "runtimes/",
      "../../out/web/": "web/"
    }
  }
}
